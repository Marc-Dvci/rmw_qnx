rcutils_strdup passes SIZE_MAX as the length bound to rcutils_strndup, which looks for the terminator with memchr.
QNX 8.0's x86_64 memchr treats the length as signed in its alignment prologue, so with SIZE_MAX and a start pointer
that is not 8-byte aligned it jumps through its table at index -1 (qnx/ros2/patches/memchr_size_max.c). Every
process that sets RMW_IMPLEMENTATION then crashes in rcl's load-time check. strnlen gives the same length.
--- a/src/strdup.c
+++ b/src/strdup.c
@@ -44,8 +44,7 @@
     return NULL;
   }
   RCUTILS_CHECK_ALLOCATOR(&allocator, return NULL);
-  char * p = memchr(str, '\0', max_length);
-  size_t string_length = p == NULL ? max_length : (size_t)(p - str);
+  size_t string_length = strnlen(str, max_length);
   char * new_string = allocator.allocate(string_length + 1, allocator.state);
   if (NULL == new_string) {
     return NULL;
